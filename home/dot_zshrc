# better history
alias history='history 1'
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000000
SAVEHIST=10000000
setopt EXTENDED_HISTORY          # Write the history file in the ":start:elapsed;command" format.
setopt INC_APPEND_HISTORY        # Write to the history file immediately, not when the shell exits.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space.
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry.
setopt HIST_VERIFY               # Don't execute immediately upon history expansion.

# default editor
export EDITOR=vim

# emacs key bindings (Ctrl-A, Ctrl-E, Ctrl-R...): zsh picks vi ones when a shell
# starts with EDITOR=vim already set, as in herdr panes
bindkey -e

# completion, including Homebrew's (brew shellenv in .zprofile adds them to fpath)
autoload -Uz compinit && compinit

# gcloud's completion: its Homebrew cask doesn't add it for zsh
[ -f /opt/homebrew/share/google-cloud-sdk/completion.zsh.inc ] &&
	source /opt/homebrew/share/google-cloud-sdk/completion.zsh.inc

# starship prompt
command -v starship >/dev/null && eval "$(starship init zsh)"
