{{- /* runs when a script that uses sudo changes, i.e. when one is about to run */ -}}
#!/bin/sh
set -eu

# scripts that use sudo (this script re-runs when one of them changes):
{{- range glob (joinPath .chezmoi.sourceDir ".chezmoiscripts/*") }}
{{-   if and (not (contains "ask-sudo" .)) (contains "sudo " (include .)) }}
{{-     if hasSuffix ".tmpl" . }}
# {{ base . }} {{ includeTemplate . $ | sha256sum }}
{{-     else }}
# {{ base . }} {{ include . | sha256sum }}
{{-     end }}
{{-   end }}
{{- end }}

# ask for the password up front, not after the long brew bundle
sudo -v -p "Password (asked once, for the scripts that need it): "
# keep it until chezmoi is done (brew bundle can outlast sudo's 5 minutes)
while kill -0 "$PPID" 2>/dev/null; do
	sudo -n true
	sleep 60
done >/dev/null 2>&1 &
