#!/bin/sh
#
# gh as my GitHub account vspiewak-<name> in ~/Dev/github-<name>/ (its own login,
# in ~/.config/gh-<name>), my personal one elsewhere: no `gh auth switch`, which
# would change the account for every other shell (e.g. agents in other herdr
# panes). An explicit GH_CONFIG_DIR wins.

case $PWD/ in
"$HOME"/Dev/github-*/*)
	name=${PWD#"$HOME"/Dev/github-}
	name=${name%%/*}
	: "${GH_CONFIG_DIR:=$HOME/.config/gh-$name}"
	export GH_CONFIG_DIR
	;;
esac
exec /opt/homebrew/bin/gh "$@"
