# homebrew
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# mise's java, etc. (shims): the version is picked from the folder each time it
# runs, for every program (agents too)
command -v mise >/dev/null && eval "$(mise activate zsh --shims)"

# Docker is Colima's: its socket here, as Testcontainers ignores docker contexts
export DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock

# my scripts (ssh-key-sync)
export PATH="$HOME/.local/bin:$PATH"
