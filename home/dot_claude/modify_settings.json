#!/bin/sh
# Claude Code's settings: mine merged into the file, the rest left to Claude Code,
# which writes it too (/config, /model, plugins)
jq -s '(.[0] // {}) * {
	# no Claude lines or session links in commits
	"attribution": {"commit": "", "sessionUrl": false},
	"permissions": {"defaultMode": "auto"},
	"model": "opus",
	"effortLevel": "xhigh",
	"statusLine": {"type": "command", "command": "~/.claude/statusline.sh", "padding": 0}
}'
