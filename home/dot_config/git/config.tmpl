{{- $key := joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub" -}}
[user]
	name = Vincent Spiewak
	email = {{ template "email" }}
{{- if stat $key }}
	signingkey = ~/.ssh/id_ed25519.pub

# sign commits and tags with the SSH key (from ssh-key-sync, also on GitHub)
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}

# work repos: work account's email, signing key and SSH key
[includeIf "gitdir:~/Dev/sephoraeme/"]
	path = ~/.config/git/sephoraeme.config

# as written by `git lfs install`
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
